# ============================================================
# Content Audit Platform - 生产环境配置模板
# 使用方法: cp .env.production.example .env.production
#         并根据实际服务器环境修改下面的全部配置项
# ============================================================

APP_NAME="ContentAuditPlatform"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_KEY=base64:请运行 php artisan key:generate --show 生成并填入此处

# ===================== 日志 =====================
LOG_CHANNEL=stack
LOG_LEVEL=warning

# ===================== 数据库 =====================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=content_audit
DB_USERNAME=audit_user
DB_PASSWORD=请修改为强密码

# ===================== 缓存驱动 =====================
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# ===================== Redis =====================
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=phpredis

# ===================== 广播驱动 =====================
BROADCAST_CONNECTION=reverb

# ===================== Reverb WebSocket =====================
REVERB_APP_ID=请修改为随机字符串
REVERB_APP_KEY=请修改为随机字符串
REVERB_APP_SECRET=请修改为随机字符串
REVERB_HOST=reverb
REVERB_PORT=8081
REVERB_SCHEME=https

# ===================== Horizon =====================
HORIZON_PREFIX=horizon
HORIZON_DOMAIN=null
HORIZON_PATH=horizon
HORIZON_MIDDLEWARE=web
HORIZON_AUTH_BASIC_USER=admin
HORIZON_AUTH_BASIC_PASSWORD=请修改

# ===================== 文件系统 =====================
FILESYSTEM_DISK=local

# ===================== Docker 端口映射 =====================
APP_PORT=8080
MYSQL_PORT=3307
REDIS_PORT=6379
REVERB_PORT=8081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
NODE_EXPORTER_PORT=9100
REDIS_EXPORTER_PORT=9121
MYSQL_EXPORTER_PORT=9104

# ===================== Grafana 管理账号 =====================
GRAFANA_USER=admin
GRAFANA_PASSWORD=请修改为强密码

# ===================== 外部服务密钥 =====================
# 图片审核 API
IMAGE_AUDIT_API_KEY=
IMAGE_AUDIT_API_SECRET=

# 文本审核 API
TEXT_AUDIT_API_KEY=
TEXT_AUDIT_API_SECRET=

# 视频审核 API
VIDEO_AUDIT_API_KEY=
VIDEO_AUDIT_API_SECRET=
